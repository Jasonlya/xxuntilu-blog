{{- $pages := where site.RegularPages "Section" "posts" -}}
[
{{- range $index, $page := $pages.ByDate.Reverse -}}
  {{- if $index }},{{ end -}}
  {
    "title": {{ $page.Title | jsonify }},
    "url": {{ $page.RelPermalink | jsonify }},
    "date": {{ $page.Date.Format "2006-01-02" | jsonify }},
    "summary": {{ ($page.Summary | plainify | htmlUnescape | htmlUnescape | truncate 180) | jsonify }},
    "content": {{ ($page.Plain | htmlUnescape | htmlUnescape | truncate 6000) | jsonify }},
    "tags": {{ $page.Params.tags | default (slice) | jsonify }},
    "categories": {{ $page.Params.categories | default (slice) | jsonify }}
  }
{{- end -}}
]
